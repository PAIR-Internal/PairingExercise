#!/usr/bin/env bash
set -euo pipefail

# Usage: ./bin/start [vue|react]   (default: vue)
FRONTEND="${1:-${FRONTEND:-vue}}"
case "$FRONTEND" in
  vue) frontend_dir=frontend ;;
  react) frontend_dir=frontend-react ;;
  *) echo "Unknown frontend: $FRONTEND (expected vue or react)" >&2; exit 1 ;;
esac

pip install -r backend/requirements.txt
npm ci --prefix "$frontend_dir"

(
  cd backend
  python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
) &
backend_pid=$!

cleanup() {
  kill "$backend_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

VITE_API_BASE_URL=/api npm run dev --prefix "$frontend_dir" -- --host 0.0.0.0 --port 3000


